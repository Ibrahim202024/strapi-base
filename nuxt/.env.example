# ?? Server ??????????????????????????????????????????????????????????????????
# Port the Nuxt dev server and the built server bind to.
PORT=3001

# Public URL of the site, used for canonical links, sitemap, and OG metadata.
WEBSITE_URL=http://localhost:3001

# ?? Strapi ???????????????????????????????????????????????????????????????????
# Strapi backend URL. Exposed to the browser (via runtimeConfig.public) so
# media URLs resolve. The API token (below) is NOT public.
STRAPI_URL=http://localhost:1337

# Read-only API token for Strapi content fetches (server-only, NEVER public).
# Generate in Strapi Admin ? Settings ? API Tokens ? Create ? Type: Read-only.
# Leave empty in local dev only if you set Strapi public permissions manually.
STRAPI_API_TOKEN=

# ?? Preview ??????????????????????????????????????????????????????????????????
# Preview / draft mode secret (server only).
# Generated by `yarn setup` and written to strapi/.env too � both MUST match.
# `yarn check:env` verifies this.
PREVIEW_SECRET=preview_secret

# ?? Webhooks ?????????????????????????????????????????????????????????????????
# Shared secret for validating incoming Strapi webhook requests.
# Set the same value in Strapi Admin ? Settings ? Webhooks ? Authorization Header.
WEBHOOK_SECRET=

# ?? Session ??????????????????????????????????????????????????????????????????
# Cookie secret � encrypts the HttpOnly cookie holding the Strapi JWT.
# Must be at least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=tobemodified

# Write token for form submissions (optional).
STRAPI_WRITE_TOKEN=
