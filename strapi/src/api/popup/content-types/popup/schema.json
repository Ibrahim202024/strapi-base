{
  "kind": "singleType",
  "collectionName": "popups",
  "info": {
    "singularName": "popup",
    "pluralName": "popups",
    "displayName": "Popup",
    "description": "Configurable popup overlay shown to visitors"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "content": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "cta_text": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta_url": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "trigger": {
      "type": "enumeration",
      "enum": [
        "on_load",
        "on_exit_intent",
        "on_scroll",
        "on_delay"
      ],
      "default": "on_load"
    },
    "delay_seconds": {
      "type": "integer",
      "default": 3,
      "min": 0,
      "max": 60
    },
    "display_frequency": {
      "type": "enumeration",
      "enum": [
        "every_visit",
        "once_per_session",
        "once_ever"
      ],
      "default": "once_per_session"
    },
    "start_date": {
      "type": "datetime"
    },
    "end_date": {
      "type": "datetime"
    }
  }
}