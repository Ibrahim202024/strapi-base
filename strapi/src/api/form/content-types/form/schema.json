{
  "kind": "collectionType",
  "collectionName": "forms",
  "info": {
    "singularName": "form",
    "pluralName": "forms",
    "displayName": "Forms",
    "description": "Reusable contact/lead forms with configurable fields"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Internal name to identify this form",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "submit_label": {
      "type": "string",
      "default": "Submit",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "success_message": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "failure_message": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "fields": {
      "type": "component",
      "repeatable": true,
      "component": "shared.form-field",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "notification_email": {
      "type": "email",
      "description": "Send submission notifications to this address",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "store_submissions": {
      "type": "boolean",
      "default": true,
      "description": "Save submissions to the database"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "submissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::form-submission.form-submission",
      "mappedBy": "form"
    }
  }
}